    fun writeString(
        value: String,
        ipAddress: String,
        port: Int = 8232,
        writeCallback: WriteCallback = object : WriteCallback {
            override fun onOperationDone() {

            }
        }
    ) {
        writeBytes(value.toByteArray(), ipAddress, port, writeCallback)
    }

    private var listenerQueue: ConcurrentLinkedQueue<WriteCallback> = ConcurrentLinkedQueue()
    private fun writeBytes(
        bytes: ByteArray,
        bcAddress: String,
        port: Int = 8889,
        writeCallback: WriteCallback = object : WriteCallback {
            override fun onOperationDone() {

            }
        }
    ) {
        var callableFeature = CompletableFuture.supplyAsync({
            logMessage(
                "UdpClientSend",
                "App >> Hardware Thread ${Thread.currentThread().id} called with: bytes = ${
                    String(
                        bytes
                    )
                }, ipAddress = $bcAddress, port = $port"
            )
            var bcSock = DatagramSocket()
            bcSock.setBroadcast(true)
            try {
                val dp =
                    DatagramPacket(bytes, bytes.size, InetAddress.getByName(bcAddress), port)
                bcSock.send(dp)
            } catch (e: Exception) {
                e.printStackTrace()
            }
            if (com.mobiled.android.base.AppConfiguration.UDP_SIMULATE_DEVICES) {
                var jsonObject = simulationDevicePayloads.get(bcAddress)
                var commandJson = JSONObject(
                    String(
                        bytes
                    )
                )
                commandJson.keys().forEach {
                    if (jsonObject?.has(it) == true) jsonObject?.put(it, commandJson.get(it))
                }
            }
        }, sendExecutor)
        callableFeature.thenAccept {
            writeCallback.onOperationDone()
        }
    }


    var udpListener: Listener? = null

    open interface Listener {
        fun onClientConnectionStatusChange()
        fun onUdpMessage(bytes: ByteArray)
    }

    open interface WriteCallback {
        fun onOperationDone()
    }
