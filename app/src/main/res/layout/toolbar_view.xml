<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewToolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_70sdp"
    android:background="@drawable/ic_toolbar_background"
    android:elevation="@dimen/_5sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_15sdp"
    android:paddingTop="@dimen/_15sdp"
    android:paddingEnd="@dimen/_15sdp"
    android:paddingBottom="@dimen/_5sdp"
    app:layout_constraintTop_toTopOf="parent">

    <Space
        android:layout_width="@dimen/_8sdp"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:src="@drawable/ic_back" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/viewLogo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="center|top"
            android:adjustViewBounds="true"
            android:src="@drawable/mobile_d_text_logo_sm"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/viewPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold"
            tools:text="Home" />

        <TextView
            android:id="@+id/viewPageSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Home"
            tools:visibility="visible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/viewDeviceSwitchRoot"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/ic_circle_border">

        <ImageView
            android:id="@+id/buttonChangeDeviceStatus"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="center"
            android:padding="@dimen/_1sdp"
            android:src="@drawable/ic_device_switch_off" />
    </FrameLayout>


    <ImageView
        android:id="@+id/viewShowOptions"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_gravity="end"
        android:src="@drawable/ic_round_plus"
        android:visibility="gone" />
</LinearLayout>