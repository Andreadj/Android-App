<resources>
    <!-- Base application theme. -->
    <style name="Theme.MobileDAndroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/primaryDarkColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/secondaryDarkColor</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/raisin_black</item>

        <item name="android:windowBackground">#000000</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <!-- Customize your theme here. -->

        <item name="android:listPreferredItemHeightLarge">@dimen/_35sdp</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/_35sdp</item>
        <item name="android:listPreferredItemHeight">@dimen/_35sdp</item>

        <item name="android:textSize">@dimen/_12sdp</item>

        <item name="alertDialogTheme">@style/AlertDialogTheme</item>

    </style>

    <style name="Theme.SplashPage" parent="Theme.MobileDAndroid">
        <item name="android:statusBarColor">#000000</item>
    </style>

    <style name="ToolbarTheme" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="colorControlNormal">@color/white</item>
        <item name="elevation">@dimen/_8sdp</item>
        <item name="android:elevation">@dimen/_8sdp</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/outlined_stroke_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="android:textColorHint">#FFFFFF</item>
        <item name="hintTextColor">#FFFFFF</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorAccent">@color/secondaryDarkColor</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondaryDarkColor</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondaryDarkColor</item>
    </style>

</resources>