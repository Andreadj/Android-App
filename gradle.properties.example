# Copy to gradle.properties only when that local file does not exist.
# Fill signing values locally. Never commit passwords or the keystore.
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true
android.defaults.buildfeatures.buildconfig=true
android.nonFinalResIds=false
org.gradle.configuration-cache=true

RELEASE_STORE_FILE=../Keystore/your-upload-key.jks
RELEASE_STORE_PASSWORD=CHANGE_ME_LOCALLY
RELEASE_KEY_ALIAS=YOUR_UPLOAD_KEY_ALIAS
RELEASE_KEY_PASSWORD=CHANGE_ME_LOCALLY
